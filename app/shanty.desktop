[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=shanty
Exec=shanty
Name=shanty
# translation example:
# your app name in German locale (de)
#
# Remember to comment out the following line, if you do not want to use
# a different app name in German locale (de).
Name[de]=shanty

[X-Sailjail]
# Replace with your organization as a reverse domain name
OrganizationName=org.myorg
# ApplicationName does not have to be identical to Name
ApplicationName=shanty
# Music permission: sandboxes in ${HOME}/Music and ${HOME}/Playlists —
# the two directories a local audio player with M3U import/export must
# see (caught by the emulator bring-up: the library scan found 0 tracks
# with the empty default permission set).
Permissions=Music
