# shares the project dir); ignore the generated build artefacts.
*.o
*.a
*.qm
/app/shanty
Makefile*

# sfdk RPM output directory
/RPMS/

# docs/ledger stay out of version control (coordinator convention)
/ISSUES.md
/PROJECT.md
/logo.jpg
.qmake.stash
documentation.list
